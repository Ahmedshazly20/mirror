rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // 🔐 HELPERS
    // =====================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function hasRole(role) {
      return isSignedIn() &&
        exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ) &&
        getUserData().role == role;
    }

    // Emergency Owner Access
    function isHardcodedOwner() {
      return isSignedIn() && (
        request.auth.token.email == "ali.blal0102@gmail.com" ||
        request.auth.token.email == "operix@gmail.com"
      );
    }

    function isOwner() {
      return isHardcodedOwner() || hasRole('owner');
    }

    function isStaff() {
      return isOwner() || hasRole('staff') || isSignedIn();
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // =====================================================
    // 👤 USERS
    // =====================================================

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isOwner() || request.auth.uid == uid);
      allow delete: if isOwner() && uid != request.auth.uid;
    }

    // =====================================================
    // ⏱️ SESSIONS
    // =====================================================

    match /sessions/{sessionId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isOwner();
    }

    // =====================================================
    // ☕ SERVICES
    // =====================================================

    match /services/{serviceId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // =====================================================
    // ⚙️ SETTINGS
    // =====================================================

    match /settings/{settingId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // =====================================================
    // 📦 PACKAGES
    // =====================================================

    match /packages/{packageId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // =====================================================
    // 💳 SUBSCRIPTIONS
    // =====================================================

    match /subscriptions/{subId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isOwner();
    }

    // =====================================================
    // 🏢 ROOMS
    // =====================================================

    match /rooms/{roomId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // =====================================================
    // 🪑 TABLES
    // =====================================================

    match /tables/{tableId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isOwner();
    }

    // =====================================================
    // 📅 BOOKINGS
    // =====================================================

    match /bookings/{bookingId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isOwner();
    }

    // =====================================================
    // 👥 CUSTOMERS
    // =====================================================

    match /customers/{customerId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isOwner();
    }

    // =====================================================
    // 📍 VISITS
    // =====================================================

    match /visits/{visitId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isOwner();
    }

    // =====================================================
    // 💵 PAYMENTS
    // =====================================================

    match /payments/{paymentId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isOwner();
    }

    // =====================================================
    // 📦 INVENTORY & MOVEMENTS
    // =====================================================

    match /inventory/{itemId} {
      allow read: if isStaff();
      allow create, update, delete: if isOwner();
    }

    match /inventoryMovements/{movementId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isOwner();
    }

    match /inventory_movements/{movementId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isOwner();
    }

    // =====================================================
    // 💸 EXPENSES
    // =====================================================

    match /expenses/{expenseId} {
      allow read: if isStaff();
      allow create, update, delete: if isStaff();
    }

    match /expenseCategories/{catId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // =====================================================
    // 📊 REPORTS
    // =====================================================

    match /reports/{reportId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // =====================================================
    // ❌ DEFAULT DENY
    // =====================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
